## Copy this file to `.env` and fill in values.
## Do not commit your real secrets.

# OpenRouter / LLM config
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AWS (app-specific)
APP_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
APP_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
APP_AWS_REGION=us-east-2

# Local AWS endpoint (e.g., LocalStack)
DEV_AWS_ENDPOINT=http://localhost:4566

# Storage
BUCKET_NAME=chainliterate-data-layer

# Chainlit auth
CHAINLIT_AUTH_SECRET=your_chainlit_auth_secret_here  # Create using: chainlit create-secret

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id_here
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Postgres
POSTGRES_USER=chainlit-root
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=chainliterate_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma / database URL, same values as Postgres section
DATABASE_URL=postgresql://chainlit-root:your_db_password_here@localhost:5432/chainliterate_db
